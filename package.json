{
  "name": "justdoit-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "quality:lcp": "npm run build && lhci collect && node scripts/assert-lcp-p75.mjs",
    "quality:a11y": "npm run build && playwright test tests/accessibility.spec.js",
    "quality:session": "vitest run src/api/sessionLifecycle.metric.test.js --reporter=junit --outputFile=quality-reports/session-lifecycle-junit.xml && node scripts/assert-session-protection.mjs",
    "quality:report": "node scripts/generate-quality-reports.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.0",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-color": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "react-window": "^2.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@lhci/cli": "^0.15.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.0.0",
    "playwright": "^1.62.1",
    "vite": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
